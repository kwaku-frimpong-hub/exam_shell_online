# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.DS_Store
tester_output.log

# Virtual environments
.venv

# Generated submission files
api/sandbox/
node_modules

# Environment variables and local secrets (at any directory depth)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Private keys and credential bundles
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
credentials.json
service-account*.json
secrets.json
secrets/

# Local databases may contain user data
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Runtime logs may contain submitted code or identifiers
logs/
*.log
